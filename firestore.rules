rules_version = '2';

// ============================================================
// Firestore Security Rules — Manutenção Clínica FSNH
// ============================================================
//
// MODELO DE SEGURANÇA:
// - "chamados": qualquer pessoa pode ABRIR um chamado (create), pois o
//   formulário de abertura é público. Mas LER, EDITAR e EXCLUIR exige
//   estar autenticado (equipe de manutenção logada via Firebase Auth).
//   A finalização de OS via link também exige login da equipe.
// - "equipamentos": área restrita — somente usuários autenticados.
// - "contadores": usado para gerar o número sequencial da OS na abertura
//   pública; precisa permitir leitura/escrita controlada nesse fluxo.
//
// COMO PUBLICAR ESTAS REGRAS:
//   Firebase Console > Firestore Database > Rules > colar > Publicar
//   (ou via CLI: `firebase deploy --only firestore:rules`)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar: usuário autenticado
    function estaLogado() {
      return request.auth != null;
    }

    // ── CHAMADOS / ORDENS DE SERVIÇO ──────────────────────────
    match /chamados/{chamadoId} {
      // Abertura de chamado é pública (formulário aberto a qualquer um)
      allow create: if true;

      // Ler, listar, editar e excluir: somente equipe autenticada
      allow read, update, delete: if estaLogado();
    }

    // ── EQUIPAMENTOS ──────────────────────────────────────────
    // Área totalmente restrita à equipe de manutenção
    match /equipamentos/{equipamentoId} {
      allow read, write: if estaLogado();
    }

    // ── CONTADORES (numeração sequencial da OS) ───────────────
    // A numeração é gerada durante a abertura pública do chamado,
    // portanto o contador precisa ser legível e incrementável nesse
    // fluxo. Não contém dados sensíveis (apenas ano/mês e sequência).
    match /contadores/{contadorId} {
      allow read, write: if true;
    }

    // ── BLOQUEIO PADRÃO ───────────────────────────────────────
    // Qualquer outra coleção não declarada acima fica negada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
